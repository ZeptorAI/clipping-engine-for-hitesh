# Copy this file to ".env" and fill in your key.
# .env is read at startup and never leaves this computer.

# Your Anthropic API key (get one at console.anthropic.com, set a spend cap!)
ANTHROPIC_API_KEY=

# Which model picks the clips. Cheaper = claude-haiku-4-5, smartest = claude-opus-5
CLIP_MODEL=claude-opus-5

# Graphics recovery: when a real on-screen graphic would be chopped by the 9:16
# crop, show the WHOLE frame instead (nothing lost). Costs ~5c/clip in vision.
# Set GRAPHICS=0 to turn it off.
GRAPHICS=1
# Model that detects graphics (vision). Blank = use CLIP_MODEL (opus-4-8).
# GRAPHICS_MODEL=claude-sonnet-5

# ElevenLabs Speech-to-Text (auto-transcribe). Get key at elevenlabs.io
ELEVENLABS_API_KEY=
# STT model: scribe_v1 (default) or scribe_v2
ELEVENLABS_MODEL=scribe_v1
